{
  "name": "@deepseek-honcho/dsh-honcho",
  "version": "0.1.0",
  "description": "Provider-neutral Honcho memory service definition for DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testkit": {
      "types": "./lib/testkit.d.ts",
      "default": "./lib/testkit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  }
}
