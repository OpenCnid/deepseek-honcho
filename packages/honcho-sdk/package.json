{
  "name": "@deepseek-honcho/dsh-honcho-sdk",
  "version": "0.2.0",
  "description": "Honcho TypeScript SDK provider and durable outbox for DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
